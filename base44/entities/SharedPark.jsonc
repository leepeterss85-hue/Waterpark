{
  "name": "SharedPark",
  "type": "object",
  "properties": {
    "share_code": {
      "type": "string",
      "title": "Share Code",
      "description": "Short unique code used to view this shared park"
    },
    "park_name": {
      "type": "string",
      "title": "Park Name",
      "description": "The shared park's name"
    },
    "player_name": {
      "type": "string",
      "title": "Player Name",
      "description": "The player who shared the park"
    },
    "game_data": {
      "type": "object",
      "title": "Game Data",
      "description": "Full serialized game state JSON"
    },
    "day": {
      "type": "number",
      "title": "Day",
      "description": "In-game day when shared"
    },
    "reputation": {
      "type": "number",
      "title": "Reputation",
      "description": "Park reputation when shared"
    },
    "guests": {
      "type": "number",
      "title": "Guests",
      "description": "Guest count when shared"
    },
    "level": {
      "type": "number",
      "title": "Level",
      "description": "Player level when shared"
    }
  },
  "required": [
    "share_code",
    "park_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}